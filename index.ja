const { Telegraf } = require('telegraf');
const config = require('./config.json');
const { handleBankCommands } = require('./src/bankGame');

if (config.BOT_TOKEN === "YOUR_TELEGRAM_BOT_TOKEN_HERE") {
    console.error("❌ خطأ: يرجى وضع توكن البوت الخاص بك في ملف config.json أولاً!");
    process.exit(1);
}

const bot = new Telegraf(config.BOT_TOKEN);

// تشغيل نظام البنك والألعاب والتفاعل بالكامل
handleBankCommands(bot);

bot.launch().then(() => {
    console.log('💰🤖 بوت بنك وألعاب CPR Archives شغال 100% الآن على التليجرام!');
}).catch((err) => {
    console.error('❌ حدث خطأ أثناء تشغيل البوت:', err);
});

// إيقاف آمن عند إغلاق السيرفر
process.once('SIGINT', () => bot.stop('SIGINT'));
process.once('SIGTERM', () => bot.stop('SIGTERM')); 
